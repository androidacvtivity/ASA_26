INSERT INTO CIS2.TABLE_OUT 
(
  PERIOADA,
  FORM,
  FORM_VERS,
  ID_MDTABLE,
  COD_CUATM,
  NR_SECTIE,
  NUME_SECTIE,
  NR_SECTIE1,
  NUME_SECTIE1,
  NR_SECTIE2,
  NUME_SECTIE2,
  NR_ROW,
  ORDINE,
  DECIMAL_POS,
  NUME_ROW,
  
  COL1, COL2, COL3, COL4, COL5, COL6, COL7, COL8, COL9, COL10, COL11, COL12, COL13, COL14, COL15, COL16
)

SELECT 
  :pPERIOADA AS PERIOADA,
  :pFORM AS FORM,
  :pFORM_VERS AS FORM_VERS,
  :pID_MDTABLE AS ID_MDTABLE,
  :pCOD_CUATM AS COD_CUATM,
  
   '0' AS NR_SECTIE,         
   '0' AS NUME_SECTIE,
   
  '0' AS NR_SECTIE1,
  '0' AS NUME_SECTIE1,
  '0' AS NR_SECTIE2,
  '0' AS NUME_SECTIE2,
  
   X.RIND AS NR_ROW,
   X.ORD AS ORDINE,
  '0000000000000000' AS DECIMAL_POS,
  
   X.INDICATOR AS NUME_ROW,


   
   
   

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT X.CUIIO)
          ELSE SUM(X.VALOARE) END, 2) AS COL1,  -- TOTAL

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '420' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '420' THEN X.VALOARE END) END, 2) AS COL2,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ IN ('500','510','520') THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ IN ('500','510','520') THEN X.VALOARE END) END, 2) AS COL3,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '530' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '530' THEN X.VALOARE END) END, 2) AS COL4,

     -- COL5: includem si codurile CFOJ 440, 684, 685, 960, conform solicitarii.
    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ IN ('540','541','550','560') THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ IN ('540','541','550','560') THEN X.VALOARE END) END, 2) AS COL5,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '540' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '540' THEN X.VALOARE END) END, 2) AS COL6,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '541' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '541' THEN X.VALOARE END) END, 2) AS COL7,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '550' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '550' THEN X.VALOARE END) END, 2) AS COL8,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '560' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '560' THEN X.VALOARE END) END, 2) AS COL9,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '590' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '590' THEN X.VALOARE END) END, 2) AS COL10,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '620' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '620' THEN X.VALOARE END) END, 2) AS COL11,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ IN ('690','430','450','700','440','684','685','960') THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ IN ('690','430','450','700','440','684','685','960') THEN X.VALOARE END) END, 2) AS COL12,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '871' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '871' THEN X.VALOARE END) END, 2) AS COL13,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '880' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '880' THEN X.VALOARE END) END, 2) AS COL14,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '993' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '993' THEN X.VALOARE END) END, 2) AS COL15,

    ROUND(CASE WHEN X.ORD = 1 THEN COUNT(DISTINCT CASE WHEN X.CFOJ = '996' THEN X.CUIIO END)
          ELSE SUM(CASE WHEN X.CFOJ = '996' THEN X.VALOARE END) END, 2) AS COL16

FROM (
    SELECT
        R.ORD,
        R.INDICATOR,
        R.RIND,
        D.CUIIO,
        TRIM(TO_CHAR(D.CFOJ)) AS CFOJ,
        CASE R.ORD
            WHEN 2 THEN D.R170_C1
            WHEN 3 THEN D.R210_C1
            WHEN 4 THEN D.R220_C1
            WHEN 5 THEN D.R221_C1
            WHEN 6 THEN D.R222_C1
            WHEN 7 THEN D.R240_C1
            WHEN 8 THEN D.R241_C1
            WHEN 9 THEN D.R242_C1
            WHEN 10 THEN D.R243_C1
            WHEN 11 THEN D.R260_C1
            WHEN 12 THEN D.R270_C1
            WHEN 13 THEN D.R280_C1
            WHEN 14 THEN D.R290_C1
            WHEN 15 THEN D.R291_C1
            WHEN 16 THEN D.R2911_C1
            WHEN 17 THEN D.R2912_C1
            WHEN 18 THEN D.R292_C1
            WHEN 19 THEN D.R293_C1
            WHEN 20 THEN D.R2931_C1
            WHEN 21 THEN D.R295_C1
            WHEN 22 THEN D.R296_C1
            WHEN 23 THEN D.R2961_C1
            WHEN 24 THEN D.R2962_C1
            WHEN 25 THEN D.R297_C1
            WHEN 26 THEN D.R300_C1
            WHEN 27 THEN D.R310_C1
            WHEN 28 THEN D.R320_C1
            WHEN 29 THEN D.R330_C1
            WHEN 30 THEN D.R340_C1
            WHEN 31 THEN D.R350_C1
            WHEN 32 THEN D.R400_C1
            WHEN 33 THEN D.R400_C2
            WHEN 34 THEN D.R400_C3
        END AS VALOARE
    FROM (
    SELECT
        D.CUIIO,
        D.CFP,
        D.CFOJ,
        SUM(CASE WHEN D.CAPITOL = 1124 AND D.RIND = '170' THEN CIS2.NVAL(D.COL1) END) AS R170_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '210' THEN CIS2.NVAL(D.COL1) END) AS R210_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '220' THEN CIS2.NVAL(D.COL1) END) AS R220_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '221' THEN CIS2.NVAL(D.COL1) END) AS R221_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '222' THEN CIS2.NVAL(D.COL1) END) AS R222_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '240' THEN CIS2.NVAL(D.COL1) END) AS R240_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '241' THEN CIS2.NVAL(D.COL1) END) AS R241_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '242' THEN CIS2.NVAL(D.COL1) END) AS R242_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '243' THEN CIS2.NVAL(D.COL1) END) AS R243_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '260' THEN CIS2.NVAL(D.COL1) END) AS R260_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '270' THEN CIS2.NVAL(D.COL1) END) AS R270_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '280' THEN CIS2.NVAL(D.COL1) END) AS R280_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '290' THEN CIS2.NVAL(D.COL1) END) AS R290_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '291' THEN CIS2.NVAL(D.COL1) END) AS R291_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '2911' THEN CIS2.NVAL(D.COL1) END) AS R2911_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '2912' THEN CIS2.NVAL(D.COL1) END) AS R2912_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '292' THEN CIS2.NVAL(D.COL1) END) AS R292_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '293' THEN CIS2.NVAL(D.COL1) END) AS R293_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '2931' THEN CIS2.NVAL(D.COL1) END) AS R2931_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '295' THEN CIS2.NVAL(D.COL1) END) AS R295_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '296' THEN CIS2.NVAL(D.COL1) END) AS R296_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '2961' THEN CIS2.NVAL(D.COL1) END) AS R2961_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '2962' THEN CIS2.NVAL(D.COL1) END) AS R2962_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '297' THEN CIS2.NVAL(D.COL1) END) AS R297_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '300' THEN CIS2.NVAL(D.COL1) END) AS R300_C1,
        SUM(CASE WHEN D.CAPITOL = 1125 AND D.RIND = '310' THEN CIS2.NVAL(D.COL1) END) AS R310_C1,
        SUM(CASE WHEN D.CAPITOL = 1126 AND D.RIND = '320' THEN CIS2.NVAL(D.COL1) END) AS R320_C1,
        SUM(CASE WHEN D.CAPITOL = 1126 AND D.RIND = '330' THEN CIS2.NVAL(D.COL1) END) AS R330_C1,
        SUM(CASE WHEN D.CAPITOL = 1126 AND D.RIND = '340' THEN CIS2.NVAL(D.COL1) END) AS R340_C1,
        SUM(CASE WHEN D.CAPITOL = 1126 AND D.RIND = '350' THEN CIS2.NVAL(D.COL1) END) AS R350_C1,
        SUM(CASE WHEN D.CAPITOL = 1127 AND D.RIND = '400' THEN CIS2.NVAL(D.COL3) END) AS R400_C1,
        SUM(CASE WHEN D.CAPITOL = 1127 AND D.RIND = '400' THEN CIS2.NVAL(D.COL4) END) AS R400_C2,
        SUM(CASE WHEN D.CAPITOL = 1127 AND D.RIND = '400' THEN CIS2.NVAL(D.COL5) END) AS R400_C3
    FROM CIS2.VW_DATA_ALL D
    INNER JOIN CIS2.RENIM R
        ON R.CUIIO = D.CUIIO
       AND R.CUIIO_VERS = D.CUIIO_VERS
    WHERE D.FORM IN (:pFORM)
      AND D.FORM_VERS = :pFORM_VERS
      AND D.PERIOADA = :pPERIOADA
      AND D.CAPITOL IN (100, 1123, 1124, 1125, 1126, 1127, 1128, 1129)
    GROUP BY D.CUIIO, D.CFP, D.CFOJ
    HAVING (
           SUM(CASE WHEN D.ID_MD = 62382 AND D.COL1 IS NOT NULL
                    THEN D.COL1 ELSE 0 END) = 1
        OR SUM(CASE WHEN D.ID_MD IN (114171, 62413) AND D.COL1 IS NOT NULL
                    THEN D.COL1 ELSE 0 END) > 0
    )
    ) D
    CROSS JOIN (
        SELECT 1 AS ORD, 'Numarul intreprinderilor total' AS INDICATOR, '01' AS RIND FROM DUAL
        UNION ALL SELECT 2 AS ORD, 'Costuri ulterioare*' AS INDICATOR, '170, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 3 AS ORD, 'Costuri şi cheltuieli operaţionale–total (rd.220+rd.240+rd. 260+rd. 270+rd. 280+rd. 290)' AS INDICATOR, '210, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 4 AS ORD, 'Costuri şi cheltuieli materiale – total, din care:' AS INDICATOR, '220, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 5 AS ORD, 'materii prime, materiale, semifabricate cumpărate, piese de schimb' AS INDICATOR, '221, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 6 AS ORD, 'combustibil' AS INDICATOR, '222, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 7 AS ORD, 'Costuri şi cheltuieli aferente serviciilor prestate de terţi – total' AS INDICATOR, '240, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 8 AS ORD, 'de transport' AS INDICATOR, '241, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 9 AS ORD, 'de comunicaţii' AS INDICATOR, '242, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 10 AS ORD, 'de prelucrare a materiei prime proprii' AS INDICATOR, '243, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 11 AS ORD, 'Amortizarea şi deprecierea activelor imobilizate' AS INDICATOR, '260, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 12 AS ORD, 'Remunerarea muncii' AS INDICATOR, '270, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 13 AS ORD, 'Contribuţii de asigurări sociale de stat obligatorii' AS INDICATOR, '280, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 14 AS ORD, 'Alte costuri şi cheltuieli operaţionale – total (rd.291+rd.292+rd.293 +rd. 295+rd. 296+ rd. 297)' AS INDICATOR, '290, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 15 AS ORD, 'cheltuieli de deplasare' AS INDICATOR, '291, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 16 AS ORD, 'din care: cheltuieli de cazare' AS INDICATOR, '2911, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 17 AS ORD, 'diurna' AS INDICATOR, '2912, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 18 AS ORD, 'cheltuieli de protocol' AS INDICATOR, '292, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 19 AS ORD, 'cheltuieli privind asigurarea personalului şi patrimoniului' AS INDICATOR, '293, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 20 AS ORD, 'din care: asigurarea obligatorie' AS INDICATOR, '2931, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 21 AS ORD, 'impozite şi taxe incluse în cheltuieli' AS INDICATOR, '295, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 22 AS ORD, 'plați pentru leasing operaţional' AS INDICATOR, '296, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 23 AS ORD, 'din care: maşini şi utilaje' AS INDICATOR, '2961, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 24 AS ORD, 'bunuri imobiliare' AS INDICATOR, '2962, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 25 AS ORD, 'alte cheltuieli' AS INDICATOR, '297, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 26 AS ORD, 'Cheltuieli privind dobânzile pentru credite şi împrumuturi (rd.305+rd.310)' AS INDICATOR, '300, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 27 AS ORD, 'cu rezidenţii' AS INDICATOR, '310, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 28 AS ORD, 'Stocuri - total' AS INDICATOR, '320, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 29 AS ORD, 'din care: Producția în curs de execuție' AS INDICATOR, '330, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 30 AS ORD, 'Produse' AS INDICATOR, '340, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 31 AS ORD, 'Mărfuri' AS INDICATOR, '350, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 32 AS ORD, 'TOTAL' AS INDICATOR, '400, Col.1' AS RIND FROM DUAL
        UNION ALL SELECT 33 AS ORD, 'TOTAL' AS INDICATOR, '400, Col.2' AS RIND FROM DUAL
        UNION ALL SELECT 34 AS ORD, 'TOTAL' AS INDICATOR, '400, Col.3' AS RIND FROM DUAL
    ) R
) X
GROUP BY X.ORD, X.INDICATOR, X.RIND
ORDER BY X.ORD
